---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, services, testimonials } from '../data/site.js';
import { photos } from '../data/photos';

const title = 'Professional Decluttering & Home Organising in Centurion | Simply Sorted';
const description =
  'Simply Sorted helps Centurion and Pretoria homes feel calm again - professional decluttering, downsizing and deceased estates, pre-move packing, and home staging. Get in touch for a free, no-obligation chat.';
---

<style>
  .hero {
    padding-block: clamp(2.5rem, 5vw, 4.5rem) var(--space-2xl);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .hero__inner {
    max-width: 34rem;
  }

  .hero__title {
    margin-block-start: var(--space-2xs);
    max-width: 16ch;
  }

  .hero__lede {
    margin-block-start: var(--space-md);
    max-width: 46ch;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-start: var(--space-lg);
  }

  .hero__reassure {
    margin-block-start: var(--space-md);
    font-size: var(--step--1);
    color: var(--text-muted);
    font-style: italic;
  }

  @media (max-width: 62rem) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .hero__inner {
      max-width: 40rem;
      margin-inline: auto;
      text-align: center;
    }

    .hero__title,
    .hero__lede {
      margin-inline: auto;
    }

    .hero__actions {
      justify-content: center;
    }

    .hero__media {
      max-width: 24rem;
      margin-inline: auto;
    }
  }

  .teaser__head {
    margin-block-end: var(--space-xl);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: var(--space-lg) var(--space-md);
    background-color: var(--paper);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: transform var(--duration) var(--ease),
                box-shadow var(--duration) var(--ease),
                border-color var(--duration) var(--ease);
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--gold-soft);
    box-shadow: var(--shadow-md);
  }

  .card__number {
    font-family: var(--font-heading);
    font-size: var(--step-2);
    color: var(--gold-ink);
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .card__title {
    margin-block-start: var(--space-sm);
    font-size: var(--step-1);
  }

  .card__title a {
    text-decoration: none;
  }

  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card {
    position: relative;
  }

  .card__tagline {
    margin-block-start: var(--space-2xs);
    font-size: var(--step--1);
    font-style: italic;
    color: var(--moss);
  }

  .card__teaser {
    margin-block-start: var(--space-sm);
    font-size: var(--step--1);
    color: var(--text-muted);
    flex-grow: 1;
  }

  .card__more {
    margin-block-start: var(--space-md);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--evergreen);
  }

  .proof {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--space-md);
    margin-block: var(--space-xl) var(--space-xl);
  }

  .proof__item {
    margin: 0;
  }

  .proof__caption {
    margin-block-start: var(--space-xs);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    color: var(--text-muted);
  }

  .quote {
    position: relative;
    max-width: 46rem;
    margin: 0 auto;
    padding-block-start: var(--space-lg);
    padding-inline: var(--space-md);
    text-align: center;
  }

  .quote::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 7rem;
    height: 2px;
    background-image: linear-gradient(
      90deg,
      transparent,
      var(--gold) 50%,
      transparent
    );
  }

  .quote p {
    font-family: var(--font-heading);
    font-size: var(--step-2);
    line-height: 1.4;
    color: var(--text);
    margin-inline: auto;
  }

  .quote cite {
    display: block;
    margin-block-start: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-style: normal;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

</style>

<Base title={title} description={description} includeSchema>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__inner">
        <p class="eyebrow">{site.area.label}</p>
        <h1 class="hero__title">Turning everyday chaos into calm, functional spaces.</h1>
        <p class="hero__lede">
          A well-ordered home is the foundation for a peaceful mind. We work alongside
          you, at your pace, to reclaim your space - and set up systems that keep it
          that way long after we leave.
        </p>
        <div class="hero__actions">
          <a href="/contact/" class="button">Get in touch</a>
          <a href="/services/" class="button button--ghost">See what we do</a>
        </div>
        <p class="hero__reassure">
          No judgement, no pressure - we work at your pace.
        </p>
      </div>

      <div class="hero__media">
        <Photo
          src={photos.hero}
          alt="A calm, beautifully organised home - the everyday order Simply Sorted creates."
          ratio="4 / 5"
          sizes="(min-width: 62rem) 32rem, 92vw"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="section section--raised">
    <div class="container container--narrow text-center">
      <p class="eyebrow">Welcome to Simply Sorted</p>
      <h2>More than neat piles and matching bins.</h2>
      <hr class="rule rule--center" />
      <p class="lede">
        It’s about breathing new life into your existing spaces, rethinking how you
        use every square foot, and turning everyday chaos into calm, functional beauty.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="teaser__head text-center">
        <p class="eyebrow">What we offer</p>
        <h2>Support at every stage</h2>
        <hr class="rule rule--center" />
        <p class="lede">
          Whether you are clearing out years of clutter, preparing for a major move,
          or handling a loved one’s estate - you don’t have to do it alone.
        </p>
      </div>

      <ul class="cards">
        {services.map((service) => (
          <li class="card reveal">
            <span class="card__number" aria-hidden="true">{service.number}</span>
            <h3 class="card__title">
              <a href={`/services/#${service.id}`}>{service.title}</a>
            </h3>
            <p class="card__tagline">{service.tagline}</p>
            <p class="card__teaser">{service.teaser}</p>
            <span class="card__more" aria-hidden="true">Learn more →</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--raised">
    <div class="container">
      <div class="text-center">
        <p class="eyebrow">Before &amp; after</p>
        <h2>The proof is in the transformation</h2>
        <hr class="rule rule--center" />
      </div>

      <div class="proof">
        <figure class="proof__item reveal">
          <Photo
            src={photos.before}
            alt="A client's space before Simply Sorted: crowded shelves with no clear system."
            ratio="4 / 5"
            sizes="(min-width: 62rem) 28rem, 92vw"
          />
          <figcaption class="proof__caption">Before</figcaption>
        </figure>
        <figure class="proof__item reveal">
          <Photo
            src={photos.after}
            alt="The same space after Simply Sorted: sorted, grouped and easy to keep tidy."
            ratio="4 / 5"
            sizes="(min-width: 62rem) 28rem, 92vw"
          />
          <figcaption class="proof__caption">After</figcaption>
        </figure>
      </div>

      {testimonials.map((testimonial) => (
        <blockquote class="quote reveal">
          <p>&ldquo;{testimonial.quote}&rdquo;</p>
          <cite>{testimonial.name}</cite>
        </blockquote>
      ))}
    </div>
  </section>

  <CtaBand text="Whatever the room, whatever the reason - we make it feel calm again." />
</Base>
