---
/**
 * Wordmark placeholder, built to match the client's supplied logo:
 * a green calligraphic "S" swoosh, the "Simply Sorted" wordmark, and the
 * tagline "The art of everyday order".
 *
 * When Carolyn supplies the final artwork, drop it in /public/logo.svg and
 * replace the <svg> below with an <img>. Nothing else needs to change.
 */
interface Props {
  variant?: 'default' | 'inverse';
  showTagline?: boolean;
  class?: string;
}

const { variant = 'default', showTagline = true, class: className = '' } = Astro.props;

const markColor = variant === 'inverse' ? '#BFCFBB' : '#8EA58C';
const textColor = variant === 'inverse' ? '#F4F1EB' : '#344C3D';
const taglineColor = variant === 'inverse' ? '#BFCFBB' : '#738A6E';
---

<span class:list={['logo', className]}>
  <svg
    class="logo__mark"
    viewBox="0 0 64 64"
    role="img"
    aria-label="Simply Sorted"
    focusable="false"
  >
    <!-- Calligraphic S: thick on the diagonal, tapering into hairlines. -->
    <path
      d="M47.5 16.5c-4.6-4.9-11.4-7.2-18.2-6.3-7.9 1-14.2 6.4-15.6 13.4-1.3 6.6 2.4 12.3 9.7 15.4l9.6 4.1c4.6 2 6.7 4.6 6.1 7.6-.7 3.5-4.6 6-9.6 6.2-5.6.2-10.9-2.4-14.3-6.9"
      fill="none"
      stroke={markColor}
      stroke-width="5.5"
      stroke-linecap="round"
    />
    <path
      d="M13.5 47.9c3.6 4.3 9.2 6.7 15.1 6.4"
      fill="none"
      stroke={markColor}
      stroke-width="2"
      stroke-linecap="round"
      opacity="0.55"
    />
  </svg>

  <span class="logo__text">
    <span class="logo__name" style={`color:${textColor}`}>Simply Sorted</span>
    {showTagline && (
      <span class="logo__tagline" style={`color:${taglineColor}`}>
        The art of everyday order
      </span>
    )}
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    line-height: 1;
  }

  .logo__mark {
    width: 2.6rem;
    height: 2.6rem;
    flex-shrink: 0;
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
  }

  .logo__name {
    font-family: var(--font-heading);
    font-size: 1.55rem;
    font-weight: 500;
    letter-spacing: 0.005em;
    line-height: 1;
  }

  .logo__tagline {
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    line-height: 1;
  }

  @media (max-width: 26rem) {
    .logo__mark {
      width: 2.1rem;
      height: 2.1rem;
    }

    .logo__name {
      font-size: 1.3rem;
    }

    .logo__tagline {
      font-size: 0.55rem;
    }
  }
</style>
