---
interface Props {
  variant?: 'default' | 'inverse';
  showTagline?: boolean;
  class?: string;
}

const { variant = 'default', showTagline = true, class: className = '' } = Astro.props;
---

<style>
  .logo {
    --mark-primary: var(--logo-primary);
    --mark-accent: var(--logo-accent);
    --mark-word: var(--logo-primary);

    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    line-height: 1;
  }

  .logo--inverse {
    --mark-primary: var(--linen);
    --mark-accent: var(--gold-light);
    --mark-word: var(--linen);
  }

  .logo__mark {
    width: 2.9rem;
    height: 2.9rem;
    flex-shrink: 0;
  }

  .mark-line {
    fill: none;
    stroke: var(--mark-primary);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mark-accent {
    fill: none;
    stroke: var(--mark-accent);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mark-accent-fill {
    fill: var(--mark-accent);
    stroke: none;
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 0.26rem;
    color: var(--mark-word);
  }

  .logo__name {
    font-family: var(--font-body);
    font-size: 1.12rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1;
  }

  .logo__tagline {
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 1;
    opacity: 0.92;
  }

  @media (max-width: 26rem) {
    .logo {
      gap: 0.5rem;
    }

    .logo__mark {
      width: 2.3rem;
      height: 2.3rem;
    }

    .logo__name {
      font-size: 0.92rem;
      letter-spacing: 0.16em;
    }

    .logo__tagline {
      font-size: 0.54rem;
    }
  }
</style>

<span class:list={['logo', `logo--${variant}`, className]}>
  <svg
    class="logo__mark"
    viewBox="0 0 100 100"
    role="img"
    aria-label="Simply Sorted"
    focusable="false"
  >
    <path class="mark-accent" d="M55 8 A48 48 0 0 1 93 65" />

    <path class="mark-line" d="M2 24 L50 2 L50 64" />
    <path class="mark-line" d="M2 24 L2 98 L48 98" />
    <path class="mark-line" d="M2 62 L50 62" />

    <path class="mark-line" d="M9 29 H38 V56 H9 Z" />
    <path class="mark-line" d="M17 29 V56" />
    <path class="mark-line" d="M25 29 V56" />
    <path class="mark-accent" d="M18.6 31 H23.4 V54 H18.6 Z" stroke-width="2" />
    <path class="mark-accent" d="M28.5 56 L33 30.5 L37.3 31.6 L32.8 57 Z" stroke-width="2" />

    <path class="mark-line" d="M7 70 H37 a5.5 5.5 0 0 1 0 11 H13" />
    <path class="mark-accent" d="M11 84 H33 a4.5 4.5 0 0 1 0 9 H17" />

    <path class="mark-accent" d="M50 73 L71 55 L99 77" />
    <path class="mark-accent" d="M50 73 V98" />
    <path class="mark-accent" d="M92 71.5 V98" />
    <path class="mark-accent" d="M54 98 H92" />
    <rect class="mark-accent-fill" x="65" y="74" width="5" height="5" />
    <rect class="mark-accent-fill" x="72" y="74" width="5" height="5" />
    <rect class="mark-accent-fill" x="65" y="81" width="5" height="5" />
    <rect class="mark-accent-fill" x="72" y="81" width="5" height="5" />
  </svg>

  <span class="logo__text">
    <span class="logo__name">Simply Sorted</span>
    {showTagline && (
      <span class="logo__tagline">The art of everyday order</span>
    )}
  </span>
</span>
