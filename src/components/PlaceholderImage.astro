---
interface Props {
  label: string;
  ratio?: string;
  tone?: 'light' | 'mid' | 'dark';
  class?: string;
  rounded?: boolean;
}

const {
  label,
  ratio = '4 / 3',
  tone = 'mid',
  class: className = '',
  rounded = true,
} = Astro.props;

const tones = {
  light: { bg: '#E9EFE6', line: '#BFCFBB', ink: '#55684F' },
  mid: { bg: '#D6E0D2', line: '#8EA58C', ink: '#3D5340' },
  dark: { bg: '#8EA58C', line: '#738A6E', ink: '#24362B' },
};

const t = tones[tone];
---

<style>
  .ph {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    margin: 0;
    padding: var(--space-md);
    overflow: hidden;
  }

  .ph--rounded {
    border-radius: var(--radius-lg);
  }

  .ph__art {
    width: min(52%, 11rem);
    height: auto;
    opacity: 0.85;
  }

  .ph__label {
    max-width: 30ch;
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.4;
    text-align: center;
    letter-spacing: 0.02em;
    opacity: 0.8;
  }
</style>

<figure
  class:list={['ph', className, { 'ph--rounded': rounded }]}
  style={`aspect-ratio:${ratio}; background-color:${t.bg}; color:${t.ink};`}
  role="img"
  aria-label={`Placeholder image: ${label}`}
>
  <svg class="ph__art" viewBox="0 0 120 90" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid meet">
    <rect x="18" y="30" width="34" height="42" rx="2" fill="none" stroke={t.line} stroke-width="1.4" />
    <line x1="18" y1="44" x2="52" y2="44" stroke={t.line} stroke-width="1.1" />
    <line x1="18" y1="58" x2="52" y2="58" stroke={t.line} stroke-width="1.1" />
    <rect x="24" y="34" width="9" height="6" rx="1" fill={t.line} opacity="0.5" />
    <rect x="37" y="34" width="9" height="6" rx="1" fill={t.line} opacity="0.3" />
    <rect x="24" y="48" width="22" height="6" rx="1" fill={t.line} opacity="0.4" />
    <rect x="24" y="62" width="14" height="6" rx="1" fill={t.line} opacity="0.55" />
    <rect x="62" y="42" width="26" height="30" rx="2" fill="none" stroke={t.line} stroke-width="1.4" />
    <line x1="62" y1="56" x2="88" y2="56" stroke={t.line} stroke-width="1.1" />
    <rect x="67" y="46" width="16" height="5" rx="1" fill={t.line} opacity="0.45" />
    <rect x="67" y="60" width="10" height="5" rx="1" fill={t.line} opacity="0.35" />
    <circle cx="98" cy="26" r="7" fill="none" stroke={t.line} stroke-width="1.4" opacity="0.7" />
    <path d="M92 72c4-9 10-13 18-13" fill="none" stroke={t.line} stroke-width="1.4" stroke-linecap="round" opacity="0.6" />
  </svg>

  <figcaption class="ph__label">{label}</figcaption>
</figure>
