---
import { site } from '../data/site.js';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Let’s turn your chaos into calm.',
  text = `Serving ${site.area.label}.`,
} = Astro.props;
---

<style>
  .cta {
    padding-block: var(--space-2xl);
  }

  .cta__title {
    max-width: 20ch;
    margin-inline: auto;
  }

  .cta__text {
    margin-block-start: var(--space-sm);
    max-width: 52ch;
    color: var(--sage-hint);
  }
</style>

<section class="section section--inverse cta">
  <div class="container text-center">
    <h2 class="cta__title reveal">{title}</h2>
    <hr class="rule rule--center reveal" />
    <p class="cta__text reveal">{text}</p>
  </div>
</section>
