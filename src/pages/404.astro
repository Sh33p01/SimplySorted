---
import Base from '../layouts/Base.astro';
import { nav } from '../data/site.js';
---

<style>
  .notfound {
    padding-block: var(--space-2xl);
  }

  .notfound__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
  }

  .notfound__links a {
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .notfound__cta {
    margin-block-start: var(--space-lg);
  }
</style>

<Base
  title="Page not found | Simply Sorted"
  description="That page doesn't exist. Find your way back to Simply Sorted - professional decluttering and home organising in Centurion and Pretoria."
>
  <section class="section notfound">
    <div class="container container--narrow text-center">
      <p class="eyebrow">404</p>
      <h1>That page seems to have been tidied away.</h1>
      <hr class="rule rule--center" />
      <p class="lede">
        The page you were looking for isn’t here. Let’s get you back to
        somewhere useful.
      </p>

      <ul class="notfound__links">
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>

      <a href="/" class="button notfound__cta">Back to home</a>
    </div>
  </section>
</Base>
