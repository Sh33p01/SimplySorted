---
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site, services } from '../data/site.js';

const title = 'Contact Simply Sorted | Professional Organiser, Centurion & Pretoria';
const description =
  'Get in touch with Simply Sorted for decluttering, downsizing, deceased estates, pre-move packing and home staging in Centurion and Pretoria. Free, no-obligation enquiry.';
---

<style>
  .page-head {
    padding-block-start: var(--space-xl);
  }

  .contact {
    padding-block-start: var(--space-lg);
  }

  .contact__inner {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    align-items: start;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .contact__form {
    align-self: stretch;
    display: flex;
  }

  .contact__form > :global(.form-wrap) {
    flex: 1;
  }

  .contact__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    position: sticky;
    top: 7rem;
  }

  .panel {
    padding: var(--space-md);
    background-color: var(--paper);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .panel--quiet {
    background-color: var(--sand);
    border-color: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .panel__title {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-block-end: var(--space-sm);
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    font-style: normal;
  }

  .detail {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .detail__label {
    font-size: var(--step--1);
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .detail__value {
    font-size: var(--step-0);
    font-weight: 500;
    word-break: break-word;
  }

  .panel__actions {
    display: flex;
    gap: var(--space-xs);
    margin-block-start: var(--space-md);
  }

  .panel__actions .button {
    flex: 1;
  }

  .panel__note,
  .panel__text {
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.7;
    color: var(--text-muted);
  }

  .panel__note {
    margin-block-start: var(--space-md);
    font-style: italic;
  }

  .panel__list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .panel__list a {
    font-size: var(--step--1);
    text-decoration: none;
  }

  .panel__list a:hover {
    text-decoration: underline;
  }

  @media (max-width: 62rem) {
    .contact__inner {
      grid-template-columns: 1fr;
    }

    .contact__aside {
      position: static;
    }

    .contact__form {
      display: block;
    }
  }
</style>

<Base title={title} description={description}>
  <section class="section--tight page-head">
    <div class="container container--narrow text-center">
      <p class="eyebrow">Contact us</p>
      <h1>Let’s talk about your space</h1>
      <hr class="rule rule--center" />
      <p class="lede">
        Tell us a little about what’s bothering you and we’ll come back to you
        {site.responseTime}. There’s no obligation, and nothing you say will
        surprise us.
      </p>
    </div>
  </section>

  <section class="section contact">
    <div class="container contact__inner">
      <div class="contact__form">
        <EnquiryForm id="contact-form" />
      </div>

      <aside class="contact__aside">
        <div class="panel">
          <h2 class="panel__title">Contact details</h2>
          <address class="details">
            <div class="detail">
              <span class="detail__label">Business</span>
              <span class="detail__value">{site.name}</span>
            </div>
            <div class="detail">
              <span class="detail__label">Email</span>
              <a class="detail__value" href={`mailto:${site.email}`}>{site.email}</a>
            </div>
            {site.phone.publish && (
              <div class="detail">
                <span class="detail__label">Phone</span>
                <a class="detail__value" href={`tel:${site.phone.tel}`}>
                  {site.phone.display}
                </a>
              </div>
            )}
            <div class="detail">
              <span class="detail__label">Area served</span>
              <span class="detail__value">{site.area.label}, {site.area.region}</span>
            </div>
          </address>

          {site.phone.publish && (
            <div class="panel__actions">
              <a href={`tel:${site.phone.tel}`} class="button button--ghost">Call</a>
              <a
                href={`https://wa.me/${site.phone.whatsapp}`}
                class="button button--ghost"
                rel="noopener noreferrer"
                target="_blank"
              >
                WhatsApp
              </a>
            </div>
          )}

          {!site.phone.publish && (
            <p class="panel__note">
              Prefer to talk? Mention it in your message and we’ll call you back.
            </p>
          )}
        </div>

        <div class="panel">
          <h2 class="panel__title">What we can help with</h2>
          <ul class="panel__list">
            {services.map((service) => (
              <li><a href={`/services/#${service.id}`}>{service.title}</a></li>
            ))}
          </ul>
        </div>

        <div class="panel panel--quiet">
          <h2 class="panel__title">Areas covered</h2>
          <p class="panel__text">
            Simply Sorted works throughout <strong>Centurion</strong> and
            <strong>greater Pretoria</strong> - including Eldoraigne, Wierda Park,
            Highveld, Irene, Lyttelton, Doringkloof and surrounding suburbs.
            Not sure if you’re in range? Ask - we’ll happily tell you.
          </p>
        </div>
      </aside>
    </div>
  </section>
</Base>
