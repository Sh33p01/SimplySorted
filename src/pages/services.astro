---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import { services } from '../data/site.js';
import { servicePhotos } from '../data/photos.js';

const title = 'Decluttering, Downsizing, Packing & Home Staging in Centurion | Simply Sorted';
const description =
  'Four ways Simply Sorted helps Centurion and Pretoria homes: professional decluttering, downsizing and deceased estate support, pre-move decluttering and expert packing, and home staging for sale.';
---

<style>
  .page-head {
    padding-block-start: var(--space-xl);
  }

  .subnav {
    position: sticky;
    top: 5rem;
    z-index: 60;
    background-color: rgba(251, 250, 247, 0.94);
    backdrop-filter: blur(8px);
    border-block: 1px solid var(--border);
  }

  .subnav__list {
    display: flex;
    justify-content: center;
    justify-content: safe center;
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }

  .subnav__list > li {
    flex-shrink: 0;
  }

  .subnav__link {
    display: inline-block;
    padding-block: var(--space-sm);
    font-size: var(--step--1);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    color: var(--text-muted);
    border-block-end: 2px solid transparent;
    transition: color var(--duration) var(--ease),
                border-color var(--duration) var(--ease);
  }

  .subnav__link:hover {
    color: var(--evergreen);
    border-block-end-color: var(--gold);
  }

  .service--alt {
    background-color: var(--bg-raised);
  }

  .service--sensitive {
    background-color: var(--bg-raised);
    padding-block: calc(var(--space-2xl) * 1.25);
  }

  .service__inner {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    align-items: start;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .service--alt .service__body {
    order: 2;
  }

  .service__number {
    font-family: var(--font-heading);
    font-size: var(--step-2);
    color: var(--gold-ink);
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .service__title {
    margin-block-start: var(--space-2xs);
  }

  .service__tagline {
    margin-block-start: var(--space-xs);
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--moss);
  }

  .service__text + .service__text {
    margin-block-start: var(--space-sm);
  }

  .service--sensitive .service__text {
    line-height: 1.8;
  }

  .service__includes-label {
    margin-block-start: var(--space-lg);
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .service__includes {
    margin-block-start: var(--space-sm);
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    max-width: var(--measure);
  }

  .service__includes li {
    position: relative;
    padding-inline-start: 1.6rem;
  }

  .service__includes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.45rem;
    height: 0.45rem;
    transform: rotate(45deg);
    background-color: var(--gold);
  }

  .service__cta {
    margin-block-start: var(--space-lg);
  }

  .service__media {
    position: sticky;
    top: 9.5rem;
  }

  @media (max-width: 62rem) {
    .service__inner {
      grid-template-columns: 1fr;
    }

    .service--alt .service__body {
      order: 0;
    }

    .service__media {
      position: static;
      max-width: 22rem;
    }

    .subnav {
      top: 5rem;
    }
  }
</style>

<Base title={title} description={description}>
  <section class="section--tight page-head">
    <div class="container container--narrow text-center">
      <p class="eyebrow">Our Services</p>
      <h1>Support at every stage</h1>
      <hr class="rule rule--center" />
      <p class="lede">
        We know that managing your home and belongings can feel overwhelming.
        Whether you are clearing out years of clutter, preparing for a major move,
        or handling a loved one’s estate, our professional team is here to support
        you every step of the way with care and respect.
      </p>
    </div>
  </section>

  <nav class="subnav" aria-label="Services">
    <div class="container subnav__inner">
      <ul class="subnav__list">
        {services.map((service) => (
          <li>
            <a href={`#${service.id}`} class="subnav__link">{service.title}</a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  {services.map((service, index) => (
    <section
      id={service.id}
      class:list={[
        'section service',
        { 'service--alt': index % 2 === 1, 'service--sensitive': service.sensitive },
      ]}
      aria-labelledby={`${service.id}-heading`}
    >
      <div class="container service__inner">
        <div class="service__body reveal">
          <span class="service__number" aria-hidden="true">{service.number}</span>
          <h2 id={`${service.id}-heading`} class="service__title">{service.title}</h2>
          <p class="service__tagline">{service.tagline}</p>
          <hr class="rule" />

          {service.body.map((paragraph) => (
            <p class="service__text">{paragraph}</p>
          ))}

          <h3 class="service__includes-label">{service.includesLabel}</h3>
          <ul class="service__includes">
            {service.includes.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <a href={`/contact/?service=${service.id}`} class="button service__cta">
            Enquire about {service.title.toLowerCase()}
          </a>
        </div>

        <div class="service__media reveal">
          <Photo
            src={servicePhotos[service.id].src}
            alt={servicePhotos[service.id].alt}
            ratio="3 / 4"
            sizes="(min-width: 62rem) 26rem, 92vw"
          />
        </div>
      </div>
    </section>
  ))}

  <CtaBand text="Whichever service fits, we shape it around your home and your pace." />
</Base>
