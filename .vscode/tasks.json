{
  "version": "2.0.0",
  "tasks": [
    {
      // Long-running dev server with hot reload. Started automatically by the
      // "Run Simply Sorted" launch config — you shouldn't need to run it by hand.
      "label": "dev server",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "astro",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^\\s*(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          // These two MUST NOT match the same line. Astro's last output line is
          // "watching for file changes...", so anything loose enough to match it
          // here re-triggers "starting" after the server is already up, and the
          // browser then launches against a server VS Code thinks isn't ready.
          "beginsPattern": "^.*astro dev.*$",
          "endsPattern": "^.*ready in.*$"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      // Referenced by launch.json as postDebugTask so stopping the debug
      // session also shuts the server down and frees port 4321.
      // Targets only the process holding 4321 — other node apps are untouched.
      "label": "stop dev server",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Get-NetTCPConnection -LocalPort 4321 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue }; exit 0"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "npm run build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "preview production build",
      "type": "shell",
      "command": "npm run build; if ($?) { npm run preview }",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
